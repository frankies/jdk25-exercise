# Git attributes for line ending normalization, language detection, and permission preservation

# Preserve file permissions
* text=auto eol=lf

# Java files
*.java text

# Gradle files
*.gradle text
*.gradle.kts text

# Properties files
*.properties text

# Markdown
*.md text

# YAML
*.yml text
*.yaml text

# XML
*.xml text

# JSON
*.json text

# Shell scripts - preserve execute permission
*.sh text eol=lf

# Gradle wrapper for Unix/Linux/macOS
gradlew text eol=lf

# Gradle wrapper for Windows
gradlew.bat binary

# Git attributes
.gitattributes text

# Exclude binary files from line ending conversion
*.jar binary
*.zip binary
*.class binary
*.log binary
